# Application
APP_ENV=development
APP_NAME=独立教师工作台
APP_TIMEZONE=Asia/Shanghai
APP_CURRENCY=CNY
LOG_LEVEL=INFO
WEB_PORT=3000
API_PORT=8000
API_INTERNAL_URL=http://localhost:8000
TRUSTED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,test,testserver,api
APP_DOMAIN=teacher.example.invalid
SUPPORT_CONTACT=

# Optional Docker build proxy. Inside build containers, use
# host.docker.internal instead of 127.0.0.1 for a proxy running on Windows.
DOCKER_BUILD_HTTP_PROXY=
DOCKER_BUILD_HTTPS_PROXY=
DOCKER_BUILD_NO_PROXY=localhost,127.0.0.1,::1

# PostgreSQL (replace all placeholder credentials outside local development)
POSTGRES_DB=teacher_workspace
POSTGRES_USER=teacher_workspace
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://teacher_workspace:change-me-local-only@localhost:5432/teacher_workspace

# Authentication (generate a random value; never commit the real value)
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=teacher_workspace_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
REGISTRATION_ENABLED=false
REGISTRATION_INVITE_REQUIRED=false
REGISTRATION_LIMIT_PER_HOUR=10
AUTH_GLOBAL_LIMIT_PER_MINUTE=120
ACCOUNT_DELETION_GRACE_DAYS=7

# File storage
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./var/storage
MAX_UPLOAD_BYTES=20971520
USER_UPLOAD_QUOTA_BYTES=536870912
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,text/plain
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=teacher-workspace

# AI (Mock is the safe default for development and tests)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
VISION_AI_PROVIDER=mock
VISION_OPENAI_MODEL=
QWEN_API_KEY=
QWEN_VISION_MODEL=
QWEN_BASE_URL=
AI_TEMPERATURE=
AI_MAX_OUTPUT_TOKENS=8192

# PostgreSQL-backed worker
WORKER_ID=local-worker
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3

# Document generation (implemented in Phase 2)
DOCX_TEMPLATE_PATH=./var/templates/teacher-lesson-template.docx
